[Unit]
Description=Exhibit home_sim.py (fall sensor simulation)
After=network.target mosquitto.service
Wants=mosquitto.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/Exhibit
ExecStart=/home/pi/Digital_Twin/venv/bin/python /home/pi/Exhibit/home_sim.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
